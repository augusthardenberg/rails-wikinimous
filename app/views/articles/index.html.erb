<h1>All Articles</h1>

<div>
  <ul>
    <% @articles.each do |article| %>
      <li>
        <%= link_to "#{article.title}", article_path(article) %>
        <%= link_to "Delete",
        destroy_path(article),
        data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
      </li>
    <% end %>
  </ul>
</div>

<div>
  <%= link_to "Create", new_path %>
</div>
